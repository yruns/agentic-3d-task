{
  "additionalProperties": false,
  "description": "Flat scalar wire contract for the registered provider's constrained decoder.\n\n``operation`` alone selects the applicable parameters. Object operations\nconsume object_id; cell operations consume cell_x/cell_y; motion operations\nconsume repeat. Other parameter values have no effect by this contract.\nThere are no nullable values, unions, references or const schema keywords.",
  "properties": {
    "operation": {
      "enum": [
        "MoveAhead",
        "RotateLeft",
        "RotateRight",
        "LookUp",
        "LookDown",
        "PickupObject",
        "PutObject",
        "OpenObject",
        "CloseObject",
        "ToggleObjectOn",
        "ToggleObjectOff",
        "SliceObject",
        "NavigateObject",
        "NavigateCell",
        "RetrieveObject",
        "RetrieveCell",
        "Stop"
      ],
      "title": "Operation",
      "type": "string"
    },
    "object_id": {
      "minimum": 0,
      "title": "Object Id",
      "type": "integer"
    },
    "cell_x": {
      "title": "Cell X",
      "type": "integer"
    },
    "cell_y": {
      "title": "Cell Y",
      "type": "integer"
    },
    "repeat": {
      "maximum": 8,
      "minimum": 1,
      "title": "Repeat",
      "type": "integer"
    },
    "rationale": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "memory_note": {
      "maxLength": 2400,
      "title": "Memory Note",
      "type": "string"
    }
  },
  "required": [
    "operation",
    "object_id",
    "cell_x",
    "cell_y",
    "repeat",
    "rationale",
    "memory_note"
  ],
  "title": "AlfredWireDecision",
  "type": "object"
}
